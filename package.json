{
  "name": "startup",
  "version": "0.0.1",
  "private": true,
  "description": "A virtual startup: a local-first company of AI employees, shown as an office. The name is provisional.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike": "tsx scripts/spike-login.ts",
    "smoke": "tsx scripts/smoke-led-team.ts",
    "demo": "tsx scripts/demo.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "watch:web": "vite build --watch --config web/vite.config.ts",
    "story": "tsx scripts/story.ts",
    "release": "tsx scripts/release.ts",
    "live": "cd \"$HOME/.virtual-startup-app/current\" && npm start",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "open": "^11.0.4",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}
